NODE_ENV=development
PORT=4000
# Supabase Shared Pooler, session mode, IPv4. Do not use the direct IPv6 host from Render.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
CORS_ORIGINS=http://localhost:3000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# AI calls allowed per user in a rolling 24 hours.
AI_DAILY_LIMIT=60
SWAGGER_ENABLED=true
# Public web origin used in invite emails (no trailing slash).
WEB_ORIGIN=http://localhost:3000
# Optional: send invite emails via Resend when an email is set on the invite.
RESEND_API_KEY=
RESEND_FROM=Gatherly <onboarding@resend.dev>
